# Local secrets for `next dev`. Copy to .env.local (git ignores it) and fill in.
# A fine-grained token, All repositories, read-only: Contents, Issues, Pull requests, Actions, Metadata; account permission Plan.
GITHUB_TOKEN=
# UptimeRobot: Integrations, API, the read-only key.
UPTIMEROBOT_API_KEY=
# Classic token, only read:project (the boards).
GITHUB_PROJECTS_TOKEN=
# Cloudflare: a separate read-only token (Account Analytics: Read, Workers Scripts: Read, Billing: Read), and the account id. Not CLOUDFLARE_API_TOKEN, which wrangler reads.
CLOUDFLARE_ANALYTICS_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Neon API key.
NEON_API_KEY=
# Anthropic API key, used only when the brief or incident button is pressed.
ANTHROPIC_API_KEY=
# Optional: an Admin API key from the Claude Console, for this month's Claude API spend on Costs.
ANTHROPIC_ADMIN_KEY=
# Optional: a fine-grained token with Pull requests, Contents, Issues and Actions read and write, for Merge, Approve, New issue, Re-run and Run deploy.
GITHUB_WRITE_TOKEN=
