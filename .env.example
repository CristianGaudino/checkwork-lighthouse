# Local secrets for `next dev`. Copy to .env.local (git ignores it) and fill in.
# A fine-grained token, All repositories, read-only: Contents, Issues, Pull requests, Actions, Metadata; account permission Plan.
GITHUB_TOKEN=
# UptimeRobot: Integrations, API, the read-only key.
UPTIMEROBOT_API_KEY=
# Classic token, only read:project (the boards).
GITHUB_PROJECTS_TOKEN=
# Cloudflare: a token with Account Analytics: Read, and the account id.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Neon API key.
NEON_API_KEY=
# Anthropic API key, used only when the brief or incident button is pressed.
ANTHROPIC_API_KEY=
